# Leave the key empty or set MOCK_MODE=1 to run without an LLM (test answers)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_MODE=1
# comma-separated, e.g. http://localhost:5173
CORS_ORIGINS=*

# --- Free alternative: Google Gemini (OpenAI-compatible endpoint) ---
# Get a free key at https://aistudio.google.com/apikey, then use:
# OPENAI_API_KEY=<your Gemini key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash      # pick a current "flash" model from AI Studio's model list
OPENAI_BASE_URL=

# Tried in order if the main model is overloaded (comma-separated)
OPENAI_FALLBACK_MODELS=

# --- Voice: ElevenLabs text-to-speech for POST /api/speak ---
ELEVENLABS_API_KEY=
# Voice id from your ElevenLabs voice library (use a multilingual voice)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- StudentMate Agent: live mission (doctor call + lecturer email) ---
# ELEVENLABS_API_KEY above is also used for the outbound call.
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_OUTBOUND_URL=https://api.elevenlabs.io/v1/convai/twilio/outbound-call
# Optional: webhook signing secret from the ElevenLabs webhook settings (recommended once it works)
ELEVENLABS_WEBHOOK_SECRET=
# Optional: a second agent that calls the student back to confirm the appointment
ELEVENLABS_STUDENT_AGENT_ID=
# Gmail: create an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
